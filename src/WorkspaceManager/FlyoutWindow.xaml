<local:FluentWindow x:Class="WorkspaceManager.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WorkspaceManager"
        Title="Workspace Manager" Width="380" Height="600"
        ShowInTaskbar="False" Topmost="True" UseLayoutRounding="True"
        Foreground="{DynamicResource WmText}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid x:Name="Root">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="20,18,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="pack://application:,,,/app.ico" Width="30" Height="30" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="HeaderTitle" Text="Workspaces" FontSize="18" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" />
                <TextBlock x:Name="SubTitle" Style="{StaticResource WmSecondaryText}" />
            </StackPanel>
            <Button x:Name="SettingsButton" Grid.Column="2" Style="{StaticResource WmIconButton}" Content="&#xE713;"
                    ToolTip="Settings" Click="Settings_Click" VerticalAlignment="Center" />
        </Grid>

        <!-- Main -->
        <Grid x:Name="MainPanel" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid Margin="20,0,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="ProfileBox" SelectionChanged="ProfileBox_SelectionChanged" HorizontalAlignment="Stretch" />
                <Button Grid.Column="1" Style="{StaticResource WmIconButton}" Content="&#xE710;" ToolTip="New profile"
                        Margin="6,0,0,0" Click="NewProfile_Click" />
                <Button Grid.Column="2" Style="{StaticResource WmIconButton}" Content="&#xE74D;" ToolTip="Delete profile"
                        Click="DeleteProfile_Click" />
            </Grid>

            <Border x:Name="NewProfilePanel" Grid.Row="1" Style="{StaticResource WmCardStyle}" Margin="20,0,20,10" Padding="14,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="New profile" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox x:Name="NewProfileName" KeyDown="NewProfileName_KeyDown" />
                    <TextBlock x:Name="NewProfileHint" Text="Saves the apps that are open right now. Letters, numbers, - and _ only."
                               Style="{StaticResource WmSecondaryText}" TextWrapping="Wrap" Margin="0,6,0,10" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource WmButton}" Click="CancelPanel_Click" />
                        <Button Content="Create" Style="{StaticResource WmAccentButton}" Margin="8,0,0,0" Click="CreateProfile_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border x:Name="DeletePanel" Grid.Row="1" Style="{StaticResource WmCardStyle}" Margin="20,0,20,10" Padding="14,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="DeleteText" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource WmButton}" Click="CancelPanel_Click" />
                        <Button Content="Delete" Style="{StaticResource WmAccentButton}" Margin="8,0,0,0" Click="ConfirmDelete_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,0,20,4">
                <RadioButton x:Name="SavedTab" Content="Saved apps" GroupName="Tabs" Style="{StaticResource WmSegment}"
                             IsChecked="True" Checked="Tab_Checked" Margin="0,0,22,0" />
                <RadioButton x:Name="OpenTab" Content="Open now" GroupName="Tabs" Style="{StaticResource WmSegment}"
                             Checked="Tab_Checked" />
            </StackPanel>

            <Grid Grid.Row="3">
                <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" Padding="0,4,0,8"
                         ItemContainerStyle="{StaticResource WmListItem}" ItemTemplate="{StaticResource AppItemTemplate}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonUp="AppList_PreviewMouseLeftButtonUp" MouseDoubleClick="AppList_MouseDoubleClick" />
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,40">
                    <TextBlock Text="&#xE8A9;" FontFamily="{StaticResource IconFont}" FontSize="36" HorizontalAlignment="Center"
                               Foreground="{DynamicResource WmTextSecondary}" />
                    <TextBlock x:Name="EmptyText" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260"
                               Style="{StaticResource WmSecondaryText}" FontSize="13" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Settings -->
        <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,0,20,12">
                <Border Style="{StaticResource WmCardStyle}">
                    <CheckBox x:Name="StartWithWindowsToggle" Style="{StaticResource WmToggleSwitch}" Click="Toggle_Click">
                        <StackPanel>
                            <TextBlock Text="Start with Windows" />
                            <TextBlock Text="Sit in the tray after you sign in" Style="{StaticResource WmSecondaryText}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource WmCardStyle}">
                    <CheckBox x:Name="AskToggle" Style="{StaticResource WmToggleSwitch}" Click="Toggle_Click">
                        <StackPanel>
                            <TextBlock Text="Ask to reopen apps at sign-in" />
                            <TextBlock Text="You choose yes or no every time" Style="{StaticResource WmSecondaryText}" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource WmCardStyle}">
                    <CheckBox x:Name="AutoSaveToggle" Style="{StaticResource WmToggleSwitch}" Click="Toggle_Click">
                        <StackPanel>
                            <TextBlock Text="Remember my apps automatically" />
                            <TextBlock Text="Keeps “Last session” up to date in the background" Style="{StaticResource WmSecondaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource WmCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Profile to offer at sign-in" />
                        <TextBlock Text="Falls back to Default if it's empty" Style="{StaticResource WmSecondaryText}" Margin="0,0,0,8" />
                        <ComboBox x:Name="StartupProfileBox" SelectionChanged="StartupProfileBox_SelectionChanged" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource WmCardStyle}">
                    <StackPanel>
                        <Button Content="Preview the sign-in prompt" Style="{StaticResource WmButton}" HorizontalAlignment="Stretch" Click="PreviewPrompt_Click" />
                        <Button Content="Open profiles folder" Style="{StaticResource WmButton}" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="OpenFolder_Click" />
                        <Button Content="Quit Workspace Manager" Style="{StaticResource WmButton}" HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="Quit_Click" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{DynamicResource WmFooter}" BorderBrush="{DynamicResource WmDivider}" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Style="{StaticResource WmSecondaryText}" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                <StackPanel x:Name="ActionButtons" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SaveButton" Style="{StaticResource WmButton}" Click="Save_Click" ToolTip="Save the checked open apps to this profile">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RestoreButton" Style="{StaticResource WmAccentButton}" Margin="8,0,0,0" Click="Restore_Click" ToolTip="Open the checked apps">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="Reopen" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="DoneButton" Grid.Column="1" Content="Done" Style="{StaticResource WmAccentButton}" Visibility="Collapsed" Click="Settings_Click" />
            </Grid>
        </Border>
    </Grid>
</local:FluentWindow>
