<local:FluentWindow x:Class="WorkspaceManager.StartupPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WorkspaceManager"
        Title="Reopen your apps?" Width="460" Height="580"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" Topmost="True" UseLayoutRounding="True"
        Icon="pack://application:,,,/app.ico"
        Foreground="{DynamicResource WmText}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid x:Name="Root" MouseLeftButtonDown="Root_MouseLeftButtonDown" Background="Transparent">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Button Style="{StaticResource WmIconButton}" Content="&#xE8BB;" FontSize="11" HorizontalAlignment="Right"
                VerticalAlignment="Top" Margin="0,10,10,0" ToolTip="Not now" Click="No_Click" />

        <StackPanel Margin="32,32,32,18">
            <Image Source="pack://application:,,,/app.ico" Width="48" Height="48" HorizontalAlignment="Left"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="Welcome back" FontSize="28" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}" Margin="0,18,0,4" />
            <TextBlock x:Name="Lead" Text="Want to pick up where you left off?" Style="{StaticResource WmSecondaryText}"
                       FontSize="14" TextWrapping="Wrap" />
        </StackPanel>

        <ComboBox x:Name="ProfileBox" Grid.Row="1" Margin="32,0,32,12" SelectionChanged="ProfileBox_SelectionChanged" />

        <Border Grid.Row="2" Style="{StaticResource WmCardStyle}" Margin="32,0" Padding="0,6">
            <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource WmListItem}" ItemTemplate="{StaticResource AppItemTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonUp="AppList_PreviewMouseLeftButtonUp" />
        </Border>

        <CheckBox x:Name="DontAsk" Grid.Row="3" Margin="32,14,32,18" Content="Don't ask me again at sign-in" />

        <Border Grid.Row="4" Background="{DynamicResource WmFooter}" BorderBrush="{DynamicResource WmDivider}" BorderThickness="0,1,0,0" Padding="32,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Content="Not now" Style="{StaticResource WmButton}" Margin="0,0,4,0" IsCancel="True" Click="No_Click" />
                <Button x:Name="YesButton" Grid.Column="1" Style="{StaticResource WmAccentButton}" Margin="4,0,0,0" IsDefault="True" Click="Yes_Click" />
            </Grid>
        </Border>
    </Grid>
</local:FluentWindow>
