<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <Style x:Key="WmSecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WmTextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="WmCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource WmCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WmCardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="WmButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource WmText}" />
        <Setter Property="Background" Value="{DynamicResource WmControl}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WmControlStroke}" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WmControlHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WmAccentButton" TargetType="Button" BasedOn="{StaticResource WmButton}">
        <Setter Property="Foreground" Value="{DynamicResource WmAccentText}" />
        <Setter Property="Background" Value="{DynamicResource WmAccent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WmIconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource WmText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WmSubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Windows 11 style toggle switch -->
    <Style x:Key="WmToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource WmText}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Grid Grid.Column="1" Width="40" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource WmTextSecondary}" Background="Transparent" />
                            <Ellipse x:Name="Thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                     Fill="{DynamicResource WmTextSecondary}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource WmAccent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource WmAccent}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource WmAccentText}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,4,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Width" Value="14" />
                            <Setter TargetName="Thumb" Property="Height" Value="14" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pivot-style tab -->
    <Style x:Key="WmSegment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource WmTextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent">
                        <ContentPresenter Margin="0,6,0,6" HorizontalAlignment="Center" />
                        <Border x:Name="Line" Height="3" Width="16" CornerRadius="1.5" Background="{DynamicResource WmAccent}" Visibility="Hidden" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource WmText}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource WmText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WmListItem" TargetType="ListBoxItem">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,0" Margin="10,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource WmSubtleHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="AppItemTemplate">
        <Grid Height="54">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanSelect}"
                      VerticalAlignment="Center" MinWidth="0" MinHeight="0" Padding="0" Margin="0,0,8,0" />
            <Border Grid.Column="1" Width="34" Height="34" CornerRadius="6" Background="{DynamicResource WmCard}"
                    BorderBrush="{DynamicResource WmCardStroke}" BorderThickness="1" VerticalAlignment="Center">
                <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel Grid.Column="2" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource WmText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource WmSecondaryText}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
            </StackPanel>
            <Border Grid.Column="3" Visibility="{Binding StatusVisibility}" CornerRadius="10" Padding="8,3"
                    Background="{DynamicResource WmCard}" BorderBrush="{DynamicResource WmCardStroke}" BorderThickness="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource WmSuccess}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource WmTextSecondary}" />
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
